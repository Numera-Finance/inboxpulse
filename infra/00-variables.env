#!/usr/bin/env bash
# =============================================================================
# 00-variables.env — Shared configuration for all infrastructure scripts
#
# USAGE: source infra/00-variables.env
#
# Edit the values in the "REQUIRED: Edit these" section before running any
# of the infrastructure scripts.  All other values are derived automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Edit these values for your deployment
# -----------------------------------------------------------------------------

# GCP project ID (the project where all resources will be created)
export PROJECT_ID="health-474623"

# GCP region for all resources (Cloud Run, Cloud SQL, Artifact Registry, etc.)
export REGION="us-central1"

# GitHub repository in "owner/repo" format — used for Workload Identity setup
export GITHUB_REPO="your-org/crm"

# Your application's public domain names (used for Load Balancer SSL certs)
# Set to empty string to skip SSL certificate creation (uses auto-generated Cloud Run URLs)
export WEB_DOMAIN="app.yourdomain.com"      # Frontend domain  (e.g., app.example.com)
export API_DOMAIN="api.yourdomain.com"      # API domain       (e.g., api.example.com)

# Cloud SQL database password — choose a strong password (min 20 chars)
# This will be stored in Secret Manager; you will not need to remember it
export DB_PASSWORD="CHANGE_ME_use_a_strong_password_here_min20chars"

# Database name and user
export DB_NAME="crm"
export DB_USER="crm_app"

# -----------------------------------------------------------------------------
# Derived values — do not edit these unless you know what you're doing
# -----------------------------------------------------------------------------

# Artifact Registry
export REGISTRY="${REGION}-docker.pkg.dev"
export AR_REPOSITORY="crm"

# VPC and networking
export VPC_NAME="crm-vpc"
export SUBNET_NAME="crm-subnet"
export SUBNET_RANGE="10.0.0.0/20"          # 4096 IPs for Cloud Run VPC egress
export PSA_RANGE_NAME="crm-psa-range"      # Private Service Access range name
export PSA_RANGE="10.1.0.0"               # Private Service Access start IP
export PSA_PREFIX_LENGTH="16"             # /16 = 65536 IPs for Google-managed services (Cloud SQL)
export CLOUD_NAT_NAME="crm-cloud-nat"
export CLOUD_ROUTER_NAME="crm-cloud-router"

# Cloud SQL
export SQL_INSTANCE_NAME="crm-db-prod"
export SQL_REGION="${REGION}"
export SQL_TIER="db-custom-2-7680"        # 2 vCPU, 7.5 GB RAM — good production starting point

# Cloud Run service names
export SVC_WEB="crm-web"
export SVC_API="crm-api"
export SVC_GMAIL="crm-gmail"
export SVC_ANALYSIS="crm-analysis"
export SVC_NOTIFICATIONS="crm-notifications"

# Service accounts (one per Cloud Run service + CI/CD + Pub/Sub invoker)
export SA_WEB="crm-web-sa"
export SA_API="crm-api-sa"
export SA_GMAIL="crm-gmail-sa"
export SA_ANALYSIS="crm-analysis-sa"
export SA_NOTIFICATIONS="crm-notifications-sa"
export SA_PUBSUB_INVOKER="crm-pubsub-invoker-sa"
export SA_CICD="crm-cicd-sa"

# Fully-qualified service account emails
export SA_WEB_EMAIL="${SA_WEB}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_API_EMAIL="${SA_API}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_GMAIL_EMAIL="${SA_GMAIL}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_ANALYSIS_EMAIL="${SA_ANALYSIS}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_NOTIFICATIONS_EMAIL="${SA_NOTIFICATIONS}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_PUBSUB_INVOKER_EMAIL="${SA_PUBSUB_INVOKER}@${PROJECT_ID}.iam.gserviceaccount.com"
export SA_CICD_EMAIL="${SA_CICD}@${PROJECT_ID}.iam.gserviceaccount.com"

# Pub/Sub
export PUBSUB_TOPIC="gmail-notifications"
export PUBSUB_SUBSCRIPTION="gmail-push-subscription"

# Load balancer names
export LB_WEB_NAME="crm-web-lb"
export LB_API_NAME="crm-api-lb"
export LB_WEB_IP_NAME="crm-web-ip"
export LB_API_IP_NAME="crm-api-ip"

# Workload Identity Pool (GitHub Actions authentication)
export WIF_POOL_ID="crm-github-pool"
export WIF_PROVIDER_ID="crm-github-provider"

# Secret Manager secret names
export SECRET_DB_URL="crm-database-url"
export SECRET_BETTER_AUTH_SECRET="crm-better-auth-secret"
export SECRET_GOOGLE_CLIENT_ID="crm-google-client-id"
export SECRET_GOOGLE_CLIENT_SECRET="crm-google-client-secret"
export SECRET_INTERNAL_API_KEY="crm-internal-api-key"
export SECRET_ENCRYPTION_SECRET="crm-encryption-secret"
export SECRET_PUBSUB_TOKEN="crm-pubsub-verification-token"
export SECRET_INNGEST_EVENT_KEY="crm-inngest-event-key"
export SECRET_INNGEST_SIGNING_KEY="crm-inngest-signing-key"
export SECRET_LANGFUSE_SECRET_KEY="crm-langfuse-secret-key"
export SECRET_LANGFUSE_PUBLIC_KEY="crm-langfuse-public-key"
export SECRET_HUGGINGFACE_TOKEN="crm-huggingface-token"

# Monitoring notification channel email (receives alerts)
export ALERT_EMAIL="your-ops-email@yourdomain.com"

# -----------------------------------------------------------------------------
# Utility: print summary of the config
# -----------------------------------------------------------------------------
echo "========================================="
echo "CRM Infrastructure Configuration"
echo "========================================="
echo "Project:      ${PROJECT_ID}"
echo "Region:       ${REGION}"
echo "VPC:          ${VPC_NAME}  (${SUBNET_RANGE})"
echo "Cloud SQL:    ${SQL_INSTANCE_NAME}  (${SQL_TIER})"
echo "Registry:     ${REGISTRY}/${PROJECT_ID}/${AR_REPOSITORY}"
echo "Web domain:   ${WEB_DOMAIN:-<not set — will use Cloud Run URL>}"
echo "API domain:   ${API_DOMAIN:-<not set — will use Cloud Run URL>}"
echo "GitHub repo:  ${GITHUB_REPO}"
echo "========================================="
