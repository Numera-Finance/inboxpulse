# Database connection (required)
DATABASE_URL=postgres://user:password@localhost:5432/emails_db

# Optional: Cloud SQL mTLS certs. Paths can be relative to the repo root
# (e.g. ./certs/server-ca.pem). If all three are set AND the files exist,
# the server connects with mTLS.
# CLOUDSQL_SERVER_CA_PATH=./certs/server-ca.pem
# CLOUDSQL_CLIENT_CERT_PATH=./certs/client-cert.pem
# CLOUDSQL_CLIENT_KEY_PATH=./certs/client-key.pem

# Tenant ID to scope queries to (UUID). Leave blank to return rows across all
# tenants — useful when you just want to see everything in the DB. To list
# tenants:  SELECT id, name FROM tenants;
# TENANT_ID=

# Server port (default: 3000)
# PORT=3000

# ---------------------------------------------------------------------------
# Cloud Run note
# ---------------------------------------------------------------------------
# In production the CLOUDSQL_* values are injected as INLINE PEM via Secret
# Manager (CLOUDSQL_SERVER_CA / CLOUDSQL_CLIENT_CERT / CLOUDSQL_CLIENT_KEY),
# not as the *_PATH file paths above. The server prefers inline over paths.
