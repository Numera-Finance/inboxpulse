# Build-time configuration for the Chrome extension.
#
# These URLs are PUBLIC (not secrets). They are inlined into the build and used
# for API calls, the OAuth login popup, and the manifest host_permissions.
#
# Match-pattern note: Chrome host_permissions cannot contain a port, so the port
# is stripped automatically when deriving host_permissions from these URLs.
#
# - `wxt dev`   (development mode) falls back to localhost if these are unset.
# - `wxt build` (production mode)  reads .env.production.

WXT_API_URL=http://localhost:4001
WXT_WEB_URL=http://localhost:4000

# The manager sections (Dashboard / AI Analysis / Customers / Users) talk to
# crm-manager, which is IAM-gated and has no login of its own. Requests go to a
# LOCAL authenticated proxy that attaches your gcloud identity token — so this
# stays a localhost URL even in production builds, and the Cloud Run hostname
# never appears in the extension.
#
#   gcloud run services proxy crm-manager --region us-central1 --port 8080
#
# Point it straight at a locally-run `node apps/manager/src/server.js` instead
# by setting this to that server's port. See apps/manager/README.md.
WXT_MANAGER_URL=http://localhost:8080
