# Production build config (used by `wxt build` / `wxt zip`).
# Public URLs only — no secrets. Points the extension at the Cloud Run deployment.
WXT_API_URL=https://inboxpulse-api.mystartupcfo.com
WXT_WEB_URL=https://inboxpulse.mystartupcfo.com

# The manager API is IAM-gated with no login of its own, so the extension talks
# to a LOCAL `gcloud run services proxy` listener that attaches the operator's
# identity token — never to the Cloud Run hostname directly. This is localhost
# by design even in a production build. See apps/manager/README.md.
WXT_MANAGER_URL=http://localhost:8080
