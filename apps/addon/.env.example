# crm-addon — Google Workspace Add-on (HTTP / alternate runtime)
PORT=4005
NODE_ENV=development
LOG_LEVEL=info

# InboxPulse API (internal service path). SERVICE_API_KEY must match apps/api.
SERVICE_API_URL=http://localhost:4001
SERVICE_API_KEY=

# Public URL Google calls back for button actions. Local: http://localhost:4005;
# dev-in-Gmail: your ngrok/cloudflared https URL; prod: the Cloud Run URL.
ADDON_BASE_URL=http://localhost:4005

# Local-dev convenience so cards show real clone data without full
# Gmail-user -> tenant resolution (a later phase). Use a real tenant/user UUID.
ADDON_DEV_TENANT_ID=
ADDON_DEV_USER_ID=

# Who counts as the viewer when the caller carries no Google-signed token —
# local curl, and the Chrome extension's Panel tab (which cannot mint one).
# Without an address the homepage SKIPS its two entitlement-scoped sections, so
# they vanish silently rather than saying they could not be scoped.
# Read only while ADDON_VERIFY_ID_TOKEN is false. Leave blank in deployments.
ADDON_DEV_VIEWER_EMAIL=

# Verify Google's signed ID token on inbound requests. MUST be true before any
# public deployment; false for local curl testing.
ADDON_VERIFY_ID_TOKEN=false

# ---------------------------------------------------------------------------
# Analysis provider
#
# RUNTIME IS GEMINI FLASH-LITE. The local Ollama models are the demo/dogfooding
# path only -- they exist so a mailbox deliberately excluded from ingestion can
# still show a real panel, and every latency figure measured against them
# describes an M5 Pro, not production.
#
# FLASH-LITE, NOT FLASH: this runs on every thread a user opens, so the per-call
# cost is the whole economics of the feature. Measured on the real extraction
# prompt, three runs each:
#
#   gemini-3.1-flash-lite   0.86-1.07s   115 output tokens
#   gemini-2.5-flash        1.04-1.44s   149 output tokens
#
# Lite is faster AND cheaper, and got the sentiment, the dates and the open
# question right. It found 2 commitments where flash found 3 -- flash also
# picked up "will loop in our engineering lead" as separate from the date
# promise. That is the trade, and it is worth it at this price point.
#
# WHICH lite: gemini-3.1-flash-lite. Verified against the live API --
#   gemini-2.5-flash-lite      404, "no longer available to new users"
#   gemini-3.5-flash-lite      rejects reasoning_effort
#   gemini-flash-lite-latest   rejects reasoning_effort
#   gemini-3.1-flash-lite      accepts everything we send
# Set LIVE_ANALYSIS_REASONING=unset to use a variant that rejects the field.
#
# The key already exists: GOOGLE_GENERATIVE_AI_API_KEY in Secret Manager
# (project-y-email-sentiment), the same secret crm-analysis uses. Wire it the
# same way -- see the crm-analysis block in .github/workflows/deploy.yml.
#
# NOTE: packages/shared DEFAULT_LLM_MODEL is still gemini-2.5-flash and drives
# the analysis service. Changing that is a separate, platform-wide decision.
# ---------------------------------------------------------------------------
LIVE_ANALYSIS_PROVIDER=gemini
LIVE_ANALYSIS_KEY=
LIVE_ANALYSIS_MODEL=gemini-3.1-flash-lite
# Prose (reply stances). Blank falls back to LIVE_ANALYSIS_MODEL.
LIVE_ANALYSIS_FAST_MODEL=
# 'none' -- 2.5-class Flash thinks by default, billed as output tokens on top of
# the latency. With a tight max_tokens it returns a response with no `content`
# field at all, which read as "unclassifiable" and silently fell back to
# `working` on every thread. 'unset' omits the field for models that reject it.
LIVE_ANALYSIS_REASONING=none
LIVE_ANALYSIS_TIMEOUT_MS=20000

# Local demo path instead (Ollama on this machine):
#   LIVE_ANALYSIS_PROVIDER=ollama
#   LIVE_ANALYSIS_URL=http://localhost:11434
#   LIVE_ANALYSIS_MODEL=gemma3:12b
#   LIVE_ANALYSIS_FAST_MODEL=nemotron-3.5-lightning:30b-mlx

# Persist analysed threads across restarts. BLANK = off (default).
# Local disk only — never shared or synced storage. See env.ts.
#   ADDON_CACHE_DIR=/Users/you/.inboxpulse-cache
ADDON_CACHE_DIR=

# Demo only. Adds a "Show as" row that re-renders the open thread in each of the
# five modes, using that thread's real analysis. MUST be false for real users.
ADDON_DEMO_MODE=false
